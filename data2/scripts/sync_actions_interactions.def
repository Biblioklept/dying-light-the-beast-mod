					ActionCenterVerticalCorrection();
					
					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);
					ShowWeapons(0);

                    EndTransition()
                    {
                        AnimationFinished(0);
                    }
                }

                State("BiterGrabSuccessEndFlareReaction")
                {
                    RequiredActors(0);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_break_flare");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();
					ApplyLegsCorrectionPostprocess(ENABLE_ROOT_CORRECTION);
                    RemoveActor(2);
					ShowWeapons(0);
                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    DisableGravity(0);

                    EndTransition()
                    {
                        AnimationFinished();
                    }
                }
            }
		}

		TriggerStates()
		{
			TriggerState("Open")
			{
				Animation("obj_syncaction_interaction_sedan_trunk_open_01");
			}
			TriggerState("Take")
			{
				Animation("obj_syncaction_interaction_sedan_trunk_open_01");
			}
            TriggerState("None")
			{
				Animation("obj_syncaction_interaction_sedan_trunk_open_01", 0.0);
			}
			TriggerState("Close")
			{
				Animation("obj_syncaction_interaction_sedan_trunk_open_01", 0.0);
			}
		}
	}

