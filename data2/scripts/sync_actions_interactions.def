	///////////////////////////////////////////////////////////////////////////////
	// DLC2 Opening Vent Cap - Prologue Forced Crawl
	///////////////////////////////////////////////////////////////////////////////	
	
	Group("VentCap_Crawl")
	{
		UseMaginOverride();
        SyncAction("VentCap_Crawl")
        {
            Conditions()
            {
                Tags("TriggerAction_Open");
            }

            Events()
            {
                Event(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE)
                {
                    TriggerScriptEvent(1, SCRIPT_EVENT_INTERACTION);
                }
            }

            States()
            { 
                StartState("VentCap_Begin_dlc2");

                State("VentCap_Begin_dlc2")
                {

                    Animation(0, "m_fpp_syncaction_interaction_opening_vent_cap_begin_dlc2_crawl");
                    Animation(1, "obj_syncaction_interaction_opening_vent_cap_begin_dlc2_crawl");

                    RequiredActors(0, 1);
                    ActionCenter(1);
					
                    BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.7);
					ActionCenterDirection(1);
                    
                    Transition("VentCap_End_dlc2")
                    {
                        AnimationFinished();
                    }
                }

                State("VentCap_Idle_dlc2")
                {
                    Animation(0, "m_fpp_syncaction_interaction_opening_vent_cap_idle_dlc2_crawl", 0.0, true);
                    Animation(1, "obj_syncaction_interaction_opening_vent_cap_idle_dlc2_crawl", 0.0, true);

                    RequiredActors(0, 1);
                    ActionCenter(1);
					
                    BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);
					
                    //Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);

                    Transition("VentCap_Struggle_dlc2")
                    {
                        TappingGameValue(0.5);
                    }
                }

                State("VentCap_Struggle_dlc2")
                {
					Animation(0, "m_fpp_syncaction_interaction_opening_vent_cap_struggle_dlc2_crawl");
                    Animation(1, "obj_syncaction_interaction_opening_vent_cap_struggle_dlc2_crawl");
					
                    RequiredActors(0, 1);
                    ActionCenter(1);
					
                    BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);
					
                    //Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);

                    Transition("VentCap_End_dlc2")
                    {
                        AnimationFinished();
                        TappingGameValue(0.5);
                    }

                    Transition("VentCap_Idle_dlc2")
                    {
                        AnimationFinished();
                        TappingGameValue(0.0, 0.5);
                    }

                }
                State("VentCap_End_dlc2")
                {
                    RequiredActors(0, 1);

                    Animation(0, "m_fpp_syncaction_interaction_opening_vent_cap_remove_dlc2_crawl");
                    Animation(1, "obj_syncaction_interaction_opening_vent_cap_remove_dlc2_crawl");

                    ActionCenter(1);
					MaintainLookDirection(true);	
                    EndTransition()
                    {
                        AnimationFinished();
                    }
                }
            }
        }

        TriggerStates()
        {
            TriggerState("Open")
            {
                Animation("obj_syncaction_interaction_opening_vent_cap_remove_dlc2_crawl");
            }

        }
    }
	
