        SyncAction("BoltDoor_Mirror_WrongSide","DoorTryHandle_LeftDoors")
        {
            Conditions()
			{
                SkinNameEqual(1, "Default_left");
                Tags("TriggerAction_CheckLocked");
                DirectionOffset(0, 1, 0, 90, 180);
			}
            
            Events()
			{
                RemoveEvent(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE);
