	///////////////////////////////////////////////////////////////////////////////
	// Prisoner Rescue - DLC2
	///////////////////////////////////////////////////////////////////////////////	
	Group("PrisonerRescueDLC2")
	{
		UseMaginOverride();
		SyncAction("PrisonerRescueDLC2")
		{	
            Conditions()
			{
			}
        
			Events()
			{
                Event(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE)
				{
					TriggerScriptEvent(1, SCRIPT_EVENT_INTERACTION);
				}            
			}
					
			States()
			{ 
				StartState("PrisonerRescueDLC2_Begin");

				State("PrisonerRescueDLC2_Begin")
				{
					
					Animation(0, "m_fpp_syncaction_interaction_rescue_prisoner_01_begin_dlc2");
					Animation(1, "obj_syncaction_interaction_rescue_prisoner_01_begin_dlc2");
                    
					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.5);
					MaintainLookDirection(true);

					ActionCenter(1);
					ActionCenterDirection(1);
                    DisablePhysics(0);					
					Transition("PrisonerRescueDLC2_Success")
					{
						AnimationFinished();
					}
                    
				}

                State("PrisonerRescueDLC2_Idle")
				{
					
					Animation(0, "m_fpp_syncaction_interaction_rescue_prisoner_01_idle_dlc2", 0.2, true);
					Animation(1, "obj_syncaction_interaction_rescue_prisoner_01_idle_dlc2", 0.2, true);

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
					
                    DisablePhysics(0);
                    Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);
                    
					Transition("PrisonerRescueDLC2_Struggle")
					{
						TappingGameValue(0.5);
					}
				}
                
                State("PrisonerRescueDLC2_Struggle")
				{
	
					Animation(0, "m_fpp_syncaction_interaction_rescue_prisoner_01_loop_dlc2");
					Animation(1, "obj_syncaction_interaction_rescue_prisoner_01_loop_dlc2");

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
					DisablePhysics(0);
                    Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);
                    
					Transition("PrisonerRescueDLC2_Success")
					{
                        AnimationFinished();
						TappingGameValue(0.5);
					}
                    Transition("PrisonerRescueDLC2_Idle")
					{
                        AnimationFinished();
                        TappingGameValue(0.0, 0.5);
					}
				}
                
                State("PrisonerRescueDLC2_Success")
				{
					Animation(0, "m_fpp_syncaction_interaction_rescue_prisoner_01_end_dlc2");
					Animation(1, "obj_syncaction_interaction_rescue_prisoner_01_end_dlc2");

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
                    
                    EnableInvulnerability(0);
                    
					MaintainLookDirection(true);	
                    DisablePhysics(0);
					EndTransition()
					{
						AnimationFinished();
					}
				}
			}
		}

		TriggerStates()
		{
			TriggerState("Use")
			{
				Animation("obj_syncaction_interaction_rescue_prisoner_01_end_dlc2");
			}
            
            TriggerState("None")
            {
                Animation("obj_syncaction_interaction_rescue_prisoner_01_begin_dlc2", 0);
            }
		}
    }


