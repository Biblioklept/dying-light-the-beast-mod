	///////////////////////////////////////////////////////////////////////////////
	// DLC2 Wagon Door
	///////////////////////////////////////////////////////////////////////////////	
	
	Group("WagonDoorDLC2")
	{
		UseMaginOverride();
		SyncAction("WagonDoorDLC2")
		{	
            Conditions()
			{
			}
        
			Events()
			{
                Event(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE)
				{
					TriggerScriptEvent(1, SCRIPT_EVENT_INTERACTION);
				}            
			}
					
			States()
			{ 
				StartState("WagonDoorDLC2_Begin");

				State("WagonDoorDLC2_Begin")
				{
					
					Animation(0, "m_fpp_syncaction_interaction_dlc2_wagon_door_open_01_start_01");
					Animation(1, "obj_syncaction_interaction_dlc2_wagon_door_open_01_start_01");
                    
					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.2);
					MaintainLookDirection(true);

					ActionCenter(1);
					ActionCenterDirection(1);
                    DisablePhysics(0);					
					Transition("WagonDoorDLC2_Success")
					{
						AnimationFinished();
					}
                    
				}

                State("WagonDoorDLC2_Idle")
				{
					
					Animation(0, "m_fpp_syncaction_interaction_dlc2_wagon_door_open_01_idle_01", 0.2, true);
					Animation(1, "obj_syncaction_interaction_dlc2_wagon_door_open_01_idle_01", 0.2, true);

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
					
                    DisablePhysics(0);
                    Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);
                    
					Transition("WagonDoorDLC2_Struggle")
					{
						TappingGameValue(0.5);
					}
				}
                
                State("WagonDoorDLC2_Struggle")
				{
	
					Animation(0, "m_fpp_syncaction_interaction_dlc2_wagon_door_open_01_push_01");
					Animation(1, "obj_syncaction_interaction_dlc2_wagon_door_open_01_push_01");

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
					DisablePhysics(0);
                    Breakable(0);

                    DisableGravity(0);

                    StartTappingGame(0, 0.2, 0.75, 2.5, 6, false);
                    
					Transition("WagonDoorDLC2_Success")
					{
                        AnimationFinished();
						TappingGameValue(0.5);
					}
                    Transition("WagonDoorDLC2_Idle")
					{
                        AnimationFinished();
                        TappingGameValue(0.0, 0.5);
					}
				}
                
                State("WagonDoorDLC2_Success")
				{
					Animation(0, "m_fpp_syncaction_interaction_dlc2_wagon_door_open_01_succes_01");
					Animation(1, "obj_syncaction_interaction_dlc2_wagon_door_open_01_succes_01");

					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendLookDirection(0.1);

					ActionCenter(1);
					ActionCenterDirection(1);
                    
                    EnableInvulnerability(0);
                    
					MaintainLookDirection(true);	
                    DisablePhysics(0);
					EndTransition()
					{
						AnimationFinished();
					}
				}
			}
		}

		TriggerStates()
		{
			TriggerState("Open")
			{
				Animation("obj_syncaction_interaction_dlc2_wagon_door_open_01_succes_01");
			}
            
            TriggerState("None")
            {
                Animation("obj_syncaction_interaction_dlc2_wagon_door_open_01_start_01", 0);
            }
		}
    }
	
