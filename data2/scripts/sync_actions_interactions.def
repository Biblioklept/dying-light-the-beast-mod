				}

				Event(ANIM_EVENT, 0, SYNCACTION_SHOW_ITEM  )
                {
                    ShowInventoryItem(0, "RIGHT", true)
                    {
                        Item("Quest_Bomb");
                    }
                }
                
                Event(ANIM_EVENT, 0, SYNCACTION_DROP_ITEM)
                {
                    AllignObjectToItem(0, "RIGHT", 1);
                    HideInventoryItem(0);
                }

			}
					
			States()
