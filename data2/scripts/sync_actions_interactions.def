	///////////////////////////////////////////////////////////////////////////////
	// Wardrobe Loot
	///////////////////////////////////////////////////////////////////////////////
	Group("Wardrobe")
	{
		UseMaginOverride();
		SyncAction("Wardrobe")
		{
            Conditions()
			{
                Tags("TriggerAction_Open");
			}
        
			Events()
			{
                Event(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE)
				{
					TriggerScriptEvent(1, SCRIPT_EVENT_INTERACTION);
				}
			}

			States()
			{ 
				StartState("Wardrobe_open");

				State("Wardrobe_open")
				{
					RequiredActors(0, 1);
					
					Animation(0, "m_fpp_syncaction_interaction_wardrobe_double");
					Animation(1, "obj_syncaction_interaction_wardrobe_double");
	
					RequiredActors(0, 1);

					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendPosition(1, 0, 0.0, 0.75);
					BlendDirection(1, 0, 0.0, 0.75);

					BlendLookDirection(0.6);

					ActionCenter(1);
					ActionCenterDirection(1);
					DisablePhysics(0);	
				    MaintainLookDirection(true);
					
					EndTransition()
					{
						AnimationFinished();
					}
				}
			}
		}
		
        SyncAction("Wardrobe_Jumpscare")
		{
            Conditions()
			{
                ActorType(2, "Biter");
                Tags("TriggerAction_Open");
			}
        
            SoundEvents()
			{
				ExitSoundEvent("set_biter_grab_out");
			}

            InputConfig()
            {
                ResetInputAction("_ACTION_USE_EQUIPEMENT");
                ResetInputAction("_ACTION_BLOCK");
            }

            Events()
            {
                Event(ANIM_EVENT, 0, INTERACTION_TRIGGER_USE)
				{
					TriggerScriptEvent(1, SCRIPT_EVENT_INTERACTION);
				}
                Event(ANIM_EVENT, 2, SYNCACTION_AI_BODY_DAMAGE)
                {
                    // Fake damage to attacker to damage his head
                    DealDamage(0, 2, "biter_grab_fake@sync_action_damage_presets.scr")
                    {
                        DamageHelper(0, "R_HAND");
                        UseInstigatorForward();
                    }
                    DealDamage(0, 2, "biter_grab_enter_unstable@sync_action_damage_presets.scr")
                    {
                        DamageProbability(0.2);
                        DamageMaxHealth(1.0);
                    }
                }
                Event(ANIM_EVENT, 2, ANIM_EVENT_GIVE_GRAB_DAMAGE)
                {
                    DealDamage(2, 0, "biter_grab@sync_action_damage_presets.scr");
                }
                Event(ANIM_EVENT, 0, SYNCACTION_TRIGGER_DEATH)
                {
                    DealDamage(0, 2, "biter_grab_kill_ragdoll@sync_action_damage_presets.scr");
                }
                Event(ANIM_EVENT, 0, SYNCACTION_SHOW_ITEM_ALT)
                {
                    ShowInventoryItem(0, "RIGHT")
                    {
                        use ItemGroup_UVFlare();
                    }
                }
                Event(ANIM_EVENT, 0, SYNCACTION_ACTIVATE_ITEM_ALT)
                {
                    ActivateInventoryItem(0, "flare_uv");
                }
                Event(ANIM_EVENT, 0, SYNCACTION_DROP_ITEM_ALT)
                {
                    DropInventoryItem(0, "flare_uv");
                    RemoveInventoryItem(0)
                    {
                        use ItemGroup_UVFlare();
                    }
                }
                Event(ANIM_EVENT, 0, SYNCACTION_SHOW_ITEM_ALT2)
                {
                    ShowInventoryItem(0, "RIGHT")
                    {
                        use ItemGroup_ThrowableKnife();
                    }
                }
                Event(ANIM_EVENT, 0, SYNCACTION_DROP_ITEM_ALT2)
                {
                    HideInventoryItem(0);
                    RemoveInventoryItem(0)
                    {
                        use ItemGroup_ThrowableKnife();
                    }
                }
                Event(ANIM_EVENT, 2, SYNCACTION_MAKE_NOISE)
                {
                    MakeNoise(2, "biter_grab");
                }
				Event(ANIM_EVENT, 0, SYNCACTION_AI_BODY_DAMAGE_SECOND)
                {
                    DealDamage(0, 2, "biter_grab_escape_body_hole@sync_action_damage_presets.scr")
                    {
                        DamageHelper(0, "DamageHelper");
                    }
                }
            }

			States()
			{
				StartState("Wardrobe_open");

				State("Wardrobe_open")
				{
					RequiredActors(0, 1, 2);
					
					Animation(0, "m_fpp_syncaction_interaction_stinger_wardrobe_double");
					Animation(1, "obj_syncaction_interaction_stinger_wardrobe_double");
					Animation(2, "m_bit_syncaction_interaction_stinger_wardrobe_double");

                    AnimationScript(2, "sync_action_anims_ai_ft.scr");
	
					BlendPosition(0, 0, 0.5, 0.5, true);
					BlendDirection(0, 0, 0.5, 2.0, true);

					BlendPosition(1, 0, 0.0, 0.75);
					BlendDirection(1, 0, 0.0, 0.75);

                    BlendPosition(2, 0, 0.1, 100.0, true);
					BlendDirection(2, 0, 0.1, 100.0, true);

					BlendLookDirection(0.6);
				    MaintainLookDirection(true);

                    DisablePhysics(2);

					ActionCenter(1);
					ActionCenterDirection(1);
					
                    Transition("BiterGrabLoop")
                    {
                        AnimationFinished();
                    }
				}
			
                State("BiterGrabLoop")
                {
                    RequiredActors(0, 2);

                    RemoveActor(1);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_loop", 0.3, true);
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_loop", 0.3, true);

                    AnimationScript(2, "sync_action_anims_ai_ft.scr");

                    ActionCenter(0);
                    ActionCenterDirection(0, 2);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    Mergeable(true);
                    
                    StartTappingGame(0, 0.2, 0.5, 2.5, 6, false);

                    AllowLook(60.0, 30.0);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    InputPrompt()
                    {
                        Action("_ACTION_USE_EQUIPEMENT");
                        Icon("weapon_throw_knives");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_ThrowableKnife();
                            }

                            PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);
                        }
                    }

                    InputPrompt()
                    {
                        Action("_ACTION_BLOCK");
                        Icon("equipment_flare");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_UVFlare();
                            }
                        }
                    }

                    Transition("BiterGrabSuccessEndStab")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_ThrowableKnife();
                        }

                        PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);

                        Input(0, "_ACTION_USE_EQUIPEMENT", 0.9);
                    }

                    Transition("BiterGrabSuccessEndFlare")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_UVFlare();
                        }

                        Input(0, "_ACTION_BLOCK", 0.9);
                    }

                    Transition("BiterGrabSuccessBegin")
                    {
                        TappingGameValue(0.25);
                    }
                }

                State("BiterGrabSuccessBegin")
                {
                    RequiredActors(0, 2);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_push");
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_push", 0.2);

                    AnimationScript(2, "sync_action_anims_ai_ft.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    Mergeable(true);

                    StartTappingGame(0, 0.2, 0.5, 2.5, 6, false);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    InputPrompt()
                    {
                        Action("_ACTION_USE_EQUIPEMENT");
                        Icon("weapon_throw_knives");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_ThrowableKnife();
                            }

                            PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);
                        }
                    }

                    InputPrompt()
                    {
                        Action("_ACTION_BLOCK");
                        Icon("equipment_flare");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_UVFlare();
                            }
                        }
                    }

                    Transition("BiterGrabSuccessEndStab")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_ThrowableKnife();
                        }

                        PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);

                        Input(0, "_ACTION_USE_EQUIPEMENT", 0.9);
                    }

                    Transition("BiterGrabSuccessEndFlare")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_UVFlare();
                        }

                        Input(0, "_ACTION_BLOCK", 0.9);
                    }

                    Transition("BiterGrabSuccessEnd")
                    {
                        TappingGameValue(1.0);
                    }

                    Transition("BiterGrabLoop")
                    {
                        TappingGameValue(0.0, 0.05);
                    }

                    // FIX COOP
                    // transition to different state  for just one frame and back can be omitted in coop (tpp) and it can result in not-looped anim sequence active past end frame (frozen pose)
                    // previous state : BiterGrabLoop -> BiterGrabSuccessBegin -> BiterGrabLoop (1 frame) -> BiterGrabSuccessBegin
                    // current state: BiterGrabLoop -> BiterGrabSuccessBegin -> BiterGrabSuccessBegin_D - > BiterGrabSuccessBegin
                    Transition("BiterGrabSuccessBegin_D")
                    {
                        AnimationFinished(0);
                    }
                }

                State("BiterGrabSuccessBegin_D")
                {
                    RequiredActors(0, 2);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_push_d");
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_push_d", 0.2);

                    AnimationScript(2, "sync_action_anims_ai_ft.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    Mergeable(true);

                    StartTappingGame(0, 0.2, 0.5, 2.5, 6, false);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    InputPrompt()
                    {
                        Action("_ACTION_USE_EQUIPEMENT");
                        Icon("weapon_throw_knives");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_ThrowableKnife();
                            }

                            PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);
                        }
                    }

                    InputPrompt()
                    {
                        Action("_ACTION_BLOCK");
                        Icon("equipment_flare");

                        Conditions()
                        {
                            InventoryItemRequired(0)
                            {
                                use ItemGroup_UVFlare();
                            }
                        }
                    }

                    Transition("BiterGrabSuccessEndStab")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_ThrowableKnife();
                        }

                        PlayerVariableBool(0, "FinisherBackWithItemEnabled", true);

                        Input(0, "_ACTION_USE_EQUIPEMENT", 0.9);
                    }

                    Transition("BiterGrabSuccessEndFlare")
                    {
                        InventoryItemRequired(0)
                        {
                            use ItemGroup_UVFlare();
                        }

                        Input(0, "_ACTION_USE_EQUIPEMENT", 0.9);
                    }

                    Transition("BiterGrabSuccessEnd")
                    {
                        TappingGameValue(1.0);
                    }

                    Transition("BiterGrabLoop")
                    {
                        TappingGameValue(0.0, 0.05);
                    }

                    Transition("BiterGrabSuccessBegin")
                    {
                        AnimationFinished(0);
                    }
                }

                State("BiterGrabSuccessEnd")
                {
                    RequiredActors(0, 2);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_break");
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_break", 0.2);

                    AnimationScript(2, "sync_action_anims_ai_ft.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    Transition("BiterGrabSuccessEndReaction")
                    {
                        AnimationFinished(0);
                    }
                }

                State("BiterGrabSuccessEndReaction")
                {
                    RequiredActors(2);

                    Animation(2, "m_bit_syncaction_grab_attacker1_01_break");
                    AnimationScript(2, "sync_action_anims_ai_ft.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess(ENABLE_ROOT_CORRECTION);

                    RemoveActor(0);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    EndTransition()
                    {
                        AnimationFinished();
                    }
                }

                State("BiterGrabSuccessEndFlare")
                {
                    RequiredActors(0, 2);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_break_flare");
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_break_flare", 0.2);

                    AnimationScript(2, "sync_action_anims_ai.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();

					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);
					ShowWeapons(0);
                    Transition("BiterGrabSuccessEndFlareReaction")
                    {
                        AnimationFinished(1);
                    }
                }

                State("BiterGrabSuccessEndStab")
                {
                    RequiredActors(0, 2);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_break_knife");
                    Animation(2, "m_bit_syncaction_grab_attacker1_01_break_knife", 0.2);

                    AnimationScript(2, "sync_action_anims_ai.scr");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();
					
					ApplyLegsCorrectionPostprocess();

                    DisableGravity(0);
                    DisableGravity(2);

                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);
					ShowWeapons(0);

                    EndTransition()
                    {
                        AnimationFinished(0);
                    }
                }

                State("BiterGrabSuccessEndFlareReaction")
                {
                    RequiredActors(0);

                    Animation(0, "m_fpp_syncaction_grab_victim_01_break_flare");

                    ActionCenter(0);
					ActionCenterVerticalCorrection();
					ApplyLegsCorrectionPostprocess(ENABLE_ROOT_CORRECTION);
                    RemoveActor(2);
					ShowWeapons(0);
                    BreakCrouch(0);
                    BlockBreakWhenDamaged(0);

                    DisableGravity(0);

                    EndTransition()
                    {
                        AnimationFinished();
                    }
                }
            }
		}
		
		TriggerStates()
		{
			TriggerState("Open")
			{
				Animation("obj_syncaction_interaction_wardrobe_double");
			}
			TriggerState("Take")
			{
				Animation("obj_syncaction_interaction_wardrobe_double");
			}
            TriggerState("None")
			{
				Animation("obj_syncaction_interaction_wardrobe_double", 0.0);
			}
			TriggerState("Close")
			{
				Animation("obj_syncaction_interaction_wardrobe_double", 0.0);
			}
		}
	}
    
